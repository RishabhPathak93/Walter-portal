# -----------------------------------------------------------------------------
# Cyber CTF Arena — environment variables (placeholders only, never commit real values)
# Copy to .env.local for local development and add the same values in
# Vercel → Project → Settings → Environment Variables.
# -----------------------------------------------------------------------------

# Public (exposed to the browser on purpose — safe values only)
# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-only secrets (NEVER prefix with NEXT_PUBLIC_)
# Supabase secret key (sb_secret_...). A legacy service_role JWT also works;
# you may set either SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random bytes. Generate with:  npm run secret:generate
# Changing it invalidates every stored flag digest (re-run the seed / reset flags).
FLAG_HMAC_SECRET=

# Email of the account that should become the first administrator.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# Optional: only used by `npm run admin:bootstrap` if that account does not exist yet.
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_USERNAME=organizer01

# Optional: public site URL used for email confirmation links
# (defaults to the request origin). Example: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=
